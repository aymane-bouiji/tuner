<Window x:Class="Tuner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Tuner" Width="1360" Height="840" MinWidth="760" MinHeight="500"
        Background="#0D1220" Icon="tuner.ico"
        FontFamily="Segoe UI Variable Text, Segoe UI" WindowStartupLocation="CenterScreen">
  <Grid>
    <wv2:WebView2 x:Name="Web"/>
    <Border x:Name="Message" Visibility="Collapsed" Background="#0D1220">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
        <TextBlock x:Name="MessageTitle" Foreground="White" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
        <TextBlock x:Name="MessageText" Foreground="#8E99B3" FontSize="14" Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
        <Button x:Name="MessageButton" Style="{StaticResource PillBtn}" Margin="0,18,0,0" HorizontalAlignment="Center" Visibility="Collapsed" Click="MessageButton_Click"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
