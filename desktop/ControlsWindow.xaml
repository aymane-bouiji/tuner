<Window x:Class="Tuner.ControlsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tuner controls" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="White" UseLayoutRounding="True"
        Left="-32000" Top="-32000" Width="16" Height="16">
  <Grid x:Name="Root" Background="#01000000" Focusable="True"
        MouseMove="Root_MouseMove" MouseLeftButtonDown="Root_MouseLeftButtonDown" MouseWheel="Root_MouseWheel">

    <!-- loading / error -->
    <Border x:Name="StatusBox" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480"
            Background="#C0050810" CornerRadius="14" Padding="28,22" Visibility="Collapsed">
      <StackPanel>
        <TextBlock x:Name="StatusTitle" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
        <TextBlock x:Name="StatusText" FontSize="13" Margin="0,8,0,0" Foreground="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap"/>
        <StackPanel x:Name="StatusActions" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
          <Button Style="{StaticResource PillBtn}" Content="Try again" Click="Retry_Click"/>
          <Button Style="{StaticResource GhostBtn}" Content="Copy link" Margin="8,0,0,0" Click="Copy_Click" ToolTip="Paste it into VLC to open it there"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- buffering -->
    <Border x:Name="BufferBox" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#A0050810"
            CornerRadius="10" Padding="14,8" Visibility="Collapsed" IsHitTestVisible="False">
      <TextBlock x:Name="BufferText" FontSize="13" Foreground="White"/>
    </Border>

    <!-- top bar -->
    <Border x:Name="TopBar" VerticalAlignment="Top" Padding="16,12,16,40">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#D0000000" Offset="0"/>
          <GradientStop Color="#00000000" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <DockPanel>
        <Button DockPanel.Dock="Left" Style="{StaticResource IconBtn}" Click="Back_Click" ToolTip="Back (Esc)">
          <Path Data="M15,18 L9,12 L15,6" Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="24" Height="24"/>
        </Button>
        <Button x:Name="NextBtn" DockPanel.Dock="Right" Style="{StaticResource PillBtn}" Content="Next episode" Click="Next_Click" Visibility="Collapsed" VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,12,0">
          <Border x:Name="LiveBadge" Background="#33FF5468" CornerRadius="5" Padding="7,2" Margin="0,0,10,0" VerticalAlignment="Center">
            <TextBlock Text="LIVE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Live}"/>
          </Border>
          <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="ZapHint" Text="↑ ↓ change channel" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="14,2,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- bottom bar -->
    <Border x:Name="BottomBar" VerticalAlignment="Bottom" Padding="16,32,16,10">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
          <GradientStop Color="#E0000000" Offset="0"/>
          <GradientStop Color="#00000000" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <StackPanel>
        <Grid x:Name="SeekWrap" Height="24">
          <Grid x:Name="SeekArea" Background="Transparent" Cursor="Hand"
                MouseLeftButtonDown="Seek_Down" MouseMove="Seek_Move" MouseLeftButtonUp="Seek_Up" MouseLeave="Seek_Leave">
            <Border Height="4" CornerRadius="2" Background="#40FFFFFF" VerticalAlignment="Center"/>
            <Border x:Name="SeekFill" Height="4" CornerRadius="2" Background="{StaticResource Accent}" VerticalAlignment="Center" HorizontalAlignment="Left" Width="0"/>
            <Ellipse x:Name="SeekThumb" Width="14" Height="14" Fill="{StaticResource Accent}" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Hidden"/>
          </Grid>
          <Canvas IsHitTestVisible="False" ClipToBounds="False">
            <Border x:Name="SeekTip" Canvas.Top="-30" Background="#F0101626" CornerRadius="6" Padding="8,3" Visibility="Hidden">
              <TextBlock x:Name="SeekTipText" FontSize="12" Typography.NumeralAlignment="Tabular"/>
            </Border>
          </Canvas>
        </Grid>
        <DockPanel Margin="0,2,0,0">
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
            <Button x:Name="PlayBtn" Style="{StaticResource IconBtn}" Click="Play_Click" ToolTip="Play / pause (Space)">
              <Path x:Name="PlayIcon" Fill="White" Width="24" Height="24" Data="M6,4.5 L10,4.5 L10,19.5 L6,19.5 Z M14,4.5 L18,4.5 L18,19.5 L14,19.5 Z"/>
            </Button>
            <Button x:Name="RewBtn" Style="{StaticResource IconBtn}" Click="Rew_Click" ToolTip="Back 10 seconds (←)">
              <Grid Width="24" Height="24">
                <Path Data="M3,12 A9,9 0 1 0 6,5.3 M3,3 L3,8 L8,8" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                <TextBlock Text="10" FontSize="7.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0"/>
              </Grid>
            </Button>
            <Button x:Name="FwdBtn" Style="{StaticResource IconBtn}" Click="Fwd_Click" ToolTip="Forward 10 seconds (→)">
              <Grid Width="24" Height="24">
                <Path Data="M21,12 A9,9 0 1 1 18,5.3 M21,3 L21,8 L16,8" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                <TextBlock Text="10" FontSize="7.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0"/>
              </Grid>
            </Button>
            <TextBlock x:Name="TimeText" FontSize="13" Foreground="#DDE2EC" VerticalAlignment="Center" Margin="10,0,0,0" Typography.NumeralAlignment="Tabular"/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="MuteBtn" Style="{StaticResource IconBtn}" Click="Mute_Click" ToolTip="Mute (M)">
              <Grid Width="24" Height="24">
                <Path Data="M11,5 L6,9 L3,9 L3,15 L6,15 L11,19 Z" Fill="White"/>
                <Path x:Name="VolWaves" Data="M15.5,8.5 A5,5 0 0 1 15.5,15.5 M18.5,5.5 A9,9 0 0 1 18.5,18.5" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Path x:Name="VolCross" Data="M16,9 L21,15 M21,9 L16,15" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
              </Grid>
            </Button>
            <Grid x:Name="VolArea" Width="86" Height="24" Background="Transparent" Cursor="Hand" Margin="2,0,8,0" VerticalAlignment="Center"
                  MouseLeftButtonDown="Vol_Down" MouseMove="Vol_Move" MouseLeftButtonUp="Vol_Up">
              <Border Height="4" CornerRadius="2" Background="#40FFFFFF" VerticalAlignment="Center"/>
              <Border x:Name="VolFill" Height="4" CornerRadius="2" Background="White" VerticalAlignment="Center" HorizontalAlignment="Left" Width="86"/>
            </Grid>
            <Button x:Name="CcBtn" Style="{StaticResource IconBtn}" Click="Cc_Click" ToolTip="Subtitles and audio (C)">
              <Grid Width="24" Height="24">
                <Rectangle x:Name="CcFrame" Width="18" Height="14" RadiusX="3" RadiusY="3" Stroke="White" StrokeThickness="2"/>
                <Path x:Name="CcLines" Data="M7.5,14 L11,14 M13,14 L16.5,14 M7.5,10.5 L9,10.5 M11,10.5 L16.5,10.5" Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              </Grid>
            </Button>
            <Button x:Name="FullBtn" Style="{StaticResource IconBtn}" Click="Full_Click" ToolTip="Full screen (F)">
              <Path x:Name="FullIcon" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="24" Height="24"
                    Data="M4,9 L4,4 L9,4 M20,9 L20,4 L15,4 M4,15 L4,20 L9,20 M20,15 L20,20 L15,20"/>
            </Button>
          </StackPanel>
        </DockPanel>
      </StackPanel>
    </Border>

    <!-- subtitles & audio menu -->
    <Popup x:Name="CcPopup" PlacementTarget="{Binding ElementName=CcBtn}" Placement="Top" HorizontalOffset="-250" VerticalOffset="-10"
           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
      <Border Background="#F7161D2E" BorderBrush="#243049" BorderThickness="1" CornerRadius="14" Padding="8" Width="310">
        <ScrollViewer MaxHeight="460" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="CcList"/>
        </ScrollViewer>
      </Border>
    </Popup>

    <!-- small notices -->
    <Border x:Name="ToastBox" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,76,0,0" Background="#F0161D2E"
            BorderBrush="#243049" BorderThickness="1" CornerRadius="10" Padding="14,8" Visibility="Collapsed" IsHitTestVisible="False">
      <TextBlock x:Name="ToastText" FontSize="13"/>
    </Border>
  </Grid>
</Window>
